{
  "name": "faithworks-cms",
  "private": true,
  "version": "1.0.0",
  "description": "Faith Works headless CMS: dashboard + API, Supabase content store. No runtime dependencies.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-static.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "seed:fixtures": "node scripts/seed-from-site.mjs",
    "supabase:check": "node scripts/supabase.mjs check",
    "supabase:seed": "node scripts/supabase.mjs seed",
    "supabase:import": "node scripts/supabase.mjs import",
    "supabase:backup": "node scripts/supabase.mjs backup"
  }
}
