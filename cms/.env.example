# Faith Works CMS: environment settings. Copy to cms/.env for local use (never commit .env).
# On Vercel/Netlify, set these in the project's Environment Variables (server-side only).
# Nothing here is ever sent to the browser.

# --- Content store -------------------------------------------------------------
# "sheets" (production, required on Vercel/Netlify) or "json" (local development only).
CMS_STORE=json
# Google Sheets (CMS_STORE=sheets). The ID is the long part of the sheet's URL.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service account (Google Cloud > IAM > Service accounts > Keys > JSON). Either the two fields…
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with \n for line breaks: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
# …or the whole JSON key file, base64-encoded (base64 -w0 key.json).
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Sign-in (Google OAuth client, type "Web application") ----------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The CMS address. Authorized redirect URI in Google Cloud: {CMS_BASE_URL}/api/auth/google/callback
CMS_BASE_URL=http://localhost:5174
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CMS_SESSION_SECRET=
CMS_SESSION_HOURS=8
# Always Super Admin (pinned); cannot be changed from the dashboard. Comma-separated.
CMS_SUPER_ADMINS=
# Optional: only these email domains may sign in (comma-separated), e.g. faithph.ai
CMS_ALLOWED_EMAIL_DOMAINS=

# --- Local development only ----------------------------------------------------
# Lets you sign in as the example.test users from the JSON fixtures without Google.
# Refused on any hosted or production deployment.
CMS_DEV_LOGIN=true

# --- Website --------------------------------------------------------------------
# The public website (used for previews and URL previews).
PUBLIC_SITE_URL=https://faithph.ai
# Secret build hook of the website project (Netlify: Build hooks; Vercel: Deploy Hooks).
# Called after every publish/unpublish so the site rebuilds with the new content.
PUBLIC_SITE_DEPLOY_HOOK_URL=
# Lets a STAGING website build read drafts (GET /api/public/preview). 32+ random characters.
# Give it only to the staging site's build settings. Leave empty to disable draft builds.
CMS_PREVIEW_TOKEN=
# Optional: hosts allowed in <iframe> embeds inside page content (comma-separated).
CMS_IFRAME_HOSTS=
