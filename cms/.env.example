# Faith Works CMS: environment settings. Copy to cms/.env for local use (never commit .env).
# On Vercel/Netlify, set these in the project's Environment Variables (server-side only).
# Nothing here is ever sent to the browser.

# --- CMS content store ----------------------------------------------------------
# "supabase" (default and required for hosted CMS content), "json" (local development only),
# or "sheets" (the earlier Google Sheets content store, kept only as an explicit rollback).
# There is no automatic fallback between stores.
CMS_STORE=json
# Supabase (CMS_STORE=supabase): Project Settings > API (or Data API).
SUPABASE_URL=
# A secret key (sb_secret_...) from Project Settings > API Keys. SERVER-SIDE ONLY: it bypasses
# Row Level Security. Never use the publishable (sb_publishable_...) or anon key here, and never
# expose this in the browser. The legacy SUPABASE_SERVICE_ROLE_KEY (service_role JWT) is still
# read when this is empty; remove it once SUPABASE_SECRET_KEY is set.
SUPABASE_SECRET_KEY=

# --- Google Sheets integration (kept for future workflows) ----------------------
# Not used for CMS content while CMS_STORE=supabase. Kept for future form, inquiry or registration
# workflows, for `npm run supabase:import -- --from-sheets`, and for the sheets:* scripts / rollback.
# The ID is the long part of the sheet's URL.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service account (Google Cloud > IAM > Service accounts > Keys > JSON). Either the two fields…
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with \n for line breaks: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
# …or the whole JSON key file, base64-encoded (base64 -w0 key.json).
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Sign-in (Google OAuth client, type "Web application") ----------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The CMS address. Authorized redirect URI in Google Cloud: {CMS_BASE_URL}/api/auth/google/callback
CMS_BASE_URL=http://localhost:5174
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CMS_SESSION_SECRET=
CMS_SESSION_HOURS=8
# Always Super Admin (pinned); cannot be changed from the dashboard. Comma-separated.
CMS_SUPER_ADMINS=
# Optional: only these email domains may sign in (comma-separated), e.g. faithph.ai
CMS_ALLOWED_EMAIL_DOMAINS=

# --- Local development only ----------------------------------------------------
# Lets you sign in as the example.test users from the JSON fixtures without Google.
# Refused on any hosted or production deployment.
CMS_DEV_LOGIN=true

# --- Website --------------------------------------------------------------------
# The public website (used for previews and URL previews).
PUBLIC_SITE_URL=https://faithph.ai
# Secret build hook of the website project (Netlify: Build hooks; Vercel: Deploy Hooks).
# Called after every publish/unpublish so the site rebuilds with the new content, and once a day
# (netlify/functions/daily-rebuild.mjs) so finished events move to "Past".
PUBLIC_SITE_DEPLOY_HOOK_URL=
# Lets a STAGING website build read drafts (GET /api/public/preview). 32+ random characters.
# Give it only to the staging site's build settings. Leave empty to disable draft builds.
CMS_PREVIEW_TOKEN=
# Optional: hosts allowed in <iframe> embeds inside page content (comma-separated).
CMS_IFRAME_HOSTS=

# --- Website form submissions (README §13) -------------------------------------
# Stored in Supabase (cms_form_submissions; run supabase/migrations/20261021000000_form_submissions.sql).
# The public endpoint POST /api/forms/submit is OFF until this lists the website's origin(s):
# https only, no path, comma-separated, e.g. https://example.com,https://faithph.ai
FORMS_ALLOWED_ORIGINS=
# Submissions per connection per 10 minutes (default 5).
FORMS_RATE_LIMIT=
# Team email alerts through Resend (https://resend.com). SERVER-SIDE ONLY. Alerts are off unless
# the key and a sender on a domain verified in Resend are both set.
RESEND_API_KEY=
# e.g. Faith Works Website <forms@your-verified-domain>
FORMS_EMAIL_FROM=
# Recipients for every form (comma-separated). Empty = default recipient (DEFAULT_NOTIFY_TO).
FORMS_NOTIFY_TO=
# Optional per-form recipients (override the default for that form), one variable per form id:
# FORMS_NOTIFY_TO_STARTER_KIT, FORMS_NOTIFY_TO_PROGRAM_INTEREST, FORMS_NOTIFY_TO_CORPORATE_INQUIRY,
# FORMS_NOTIFY_TO_SPEAKING_INQUIRY, FORMS_NOTIFY_TO_FAITH_AI_DEMO, FORMS_NOTIFY_TO_GENERAL_CONTACT,
# FORMS_NOTIFY_TO_EVENT_NOTIFY
# Copy each submission to its own tab of the Google Sheet above ("true" to switch on). Uses the
# existing GOOGLE_SHEETS_* / service-account settings and never writes any other tab.
FORMS_SHEETS_MIRROR=
FORMS_SHEETS_TAB=form_submissions
# Only after moving the website to native Netlify Forms: the JWS secret of Netlify's outgoing
# form-submission webhook (32+ random characters). Leave empty otherwise (the route stays closed).
NETLIFY_FORMS_WEBHOOK_SECRET=
