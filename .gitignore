# Dependencies / build output
node_modules/
dist/
# Note: no generic build/ rule. /build/ is the "Build with AI" page (build/index.html).
.cache/
.parcel-cache/

# Environment / secrets
.env
.env.*
*.env
!.env.example
# Local copy of the hosting environment variables (Netlify → Vercel migration), at any depth
env.local.copy
*.local.copy
# Host CLI link folders (project ids, local env pulls)
.vercel/
.netlify/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/

# Claude Code downloaded/local skills
.claude/skills/

# Temporary files
*.tmp
*.temp
*.log
# Design-skill inspector output (screenshots, reports)
.taste-skill/

# Locally installed agent skills (not part of the site)
.agents/

# Word lock files created while a document is open
~$*

# Project documents and the client brief stay local (not in git)
docs/*.docx
Faith_Works_Website_Developer_Brief.pdf
